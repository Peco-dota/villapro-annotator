# ─────────────────────────────────────────────
#  VisionQ — Environment Configuration
#  Copy this file to .env and fill in values.
#  Then run: bash setup.sh
# ─────────────────────────────────────────────

# Required: JWT signing secret — never share this with anyone.
# Generate a strong one with:  openssl rand -hex 32
VISIONQ_SECRET=

# Optional: Port to expose VisionQ on (default: 8000)
VISIONQ_PORT=8000

# Optional: Host path for all persistent data — projects, models, recordings, database.
# The directory will be created automatically if it does not exist.
# On WSL2: set this to a native Linux path (e.g. /home/<user>/villapro-data) for
# optimal training performance — setup.sh does this automatically.
VISIONQ_DATA_DIR=./villapro-data

# Optional: Override the Docker image name/tag (default: visionq:latest).
# Set this if you are pulling from a private registry, e.g.:
#   VISIONQ_IMAGE=ghcr.io/your-org/visionq:1.2.3
VISIONQ_IMAGE=visionq:latest

# Auto-set by setup.sh — do not edit manually.
# GPU system:  COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
# CPU system:  COMPOSE_FILE=docker-compose.yml
COMPOSE_FILE=docker-compose.yml
